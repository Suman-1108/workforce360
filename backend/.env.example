# WORKFORCE 360 - ENVIRONMENT TEMPLATE
APP_NAME="WorkForce 360"
APP_ENV="development"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="generate_a_secure_random_key_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (MySQL 8)
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_USER="workforce_app"
DB_PASSWORD="Root123"
DB_NAME="workforce360"
DATABASE_URL="mysql+pymysql://workforce_app:Root123@127.0.0.1:3306/workforce360?charset=utf8mb4"

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Gmail SMTP Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your_email@gmail.com"
SMTP_PASSWORD="your_app_password"
SMTP_FROM_EMAIL="your_email@gmail.com"
SMTP_FROM_NAME="WorkForce 360"
SMTP_SSL=True

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Geoapify Geolocation Configuration
GEOAPIFY_API_KEY="your_geoapify_key"

# Razorpay Configuration
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_key_secret"
RAZORPAY_MODE="test"
